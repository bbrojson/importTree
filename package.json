{
  "name": "importtree",
  "displayName": "ImportTree",
  "description": "importTree - show tree of imports of a file",
  "version": "0.1.1",
  "icon": "icon.png",
  "author": "bbrojson",
  "publisher": "bbrojson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbrojson/importTree.git"
  },
  "bugs": {
    "url": "https://github.com/bbrojson/importTree.git/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "importTree.show",
        "title": "Import tree - show",
        "category": "importTree"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/vscode": "^1.73.0",
    "eslint": "^9.13.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "@types/node": "^22.15.30",
    "ts-morph": "^26.0.0"
  }
}
